directive @isManagerFor(makerspaceIdField: String, makerspaceIdArg: String) on FIELD_DEFINITION
directive @isStaffFor(makerspaceIdField: String, makerspaceIdArg: String) on FIELD_DEFINITION

union MakerspaceHours = DefaultHours | SpecialHours

type Makerspace {
    id: ID!
    name: String!
    subtitle: String!
    description: String!
    docs_url: String!
    image_id: Int
    hidden: Boolean!
    timezone: String!
    zones: [Zone!]!
    hours: [MakerspaceHours!]!

    managers: [User!]! @isManagerFor(makerspaceIdField: "id")
    staff: [User!]! @isStaffFor(makerspaceIdField: "id")

    managerAnonymousGroup: AnonymousGroup @isManagerFor(makerspaceIdField: "id")
    staffAnonymousGroup: AnonymousGroup @isManagerFor(makerspaceIdField: "id")
}

type Query {
    makerspace(id: ID!): Makerspace
}

type Mutation {
    createMakerspace(name: String!, hidden: Boolean!): ID! @isAdmin
    deleteMakerspace(id: ID!): Boolean! @isAdmin

    setManagerSubgroups(makerspaceId: ID!, subgroups: [Int!]!): Boolean! @isManagerFor(makerspaceIdArg: "makerspaceId")
    setStaffSubgroups(makerspaceId: ID!, subgroups: [Int!]!): Boolean! @isManagerFor(makerspaceIdArg: "makerspaceId")
}
