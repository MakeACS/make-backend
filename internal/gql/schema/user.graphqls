scalar Time

directive @isAdmin on FIELD_DEFINITION

directive @isSelf on FIELD_DEFINITION # REQUIRES a target_id parameter

type User {
    id: ID!
    email: String!
    full_name: String!
    preferred_name: String!
    pronouns: String!
    join_date: Time!
    setup_complete: Boolean!
    archived: Boolean!
    notes: String!
    admin: Boolean!
    force_archive: Boolean
}

extend type Query {
    user(id: ID!): User! @isSelf  # isStaffOrSelf
    currentUser: User!
}